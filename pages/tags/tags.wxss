.add-row { display: flex; gap: 14rpx; margin-bottom: 30rpx; }
.add-row input { flex: 1; height: 78rpx; padding: 0 20rpx; border-radius: 16rpx; background: #fff; }
.add-row button { padding: 20rpx 28rpx; border-radius: 16rpx; background: #1d1d1f; color: #fff; font-size: 26rpx; }
.tag-row { display: flex; align-items: center; gap: 24rpx; padding: 26rpx 16rpx; border-bottom: 1rpx solid #dedee0; }
.tag-name { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.tag-name.inactive { color: #86868b; }
.tag-row button { display: flex; flex: none; align-items: center; min-height: 80rpx; color: #555559; font-size: 25rpx; }.tag-row .delete { color: #b42318; }
.rename-overlay { position: fixed; inset: 0; z-index: 2; background: rgba(0,0,0,.35); }
.rename-sheet { position: fixed; left: 30rpx; right: 30rpx; top: 50%; z-index: 3; transform: translateY(-50%); padding: 32rpx; border-radius: 24rpx; background: #fff; }
.rename-title { font-size: 32rpx; font-weight: 600; }
.rename-sheet input { height: 80rpx; margin-top: 24rpx; padding: 0 20rpx; border-radius: 14rpx; background: #f4f4f5; }
.rename-help { margin-top: 16rpx; color: #6e6e73; font-size: 23rpx; }
.rename-actions { display: flex; justify-content: flex-end; gap: 28rpx; margin-top: 30rpx; }
.rename-actions button:last-child { color: #1d1d1f; font-weight: 600; }
