/* ===== 自定义导航 ===== */
.nav { position: fixed; top: 0; left: 0; right: 0; z-index: 300; background: rgba(242,240,237,.86); backdrop-filter: blur(20rpx); -webkit-backdrop-filter: blur(20rpx); }
.nav-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 24rpx; }
.nav-side { display: flex; align-items: center; min-width: 0; }
.nav-side.right { justify-content: flex-end; }
.nav-title { font-size: 34rpx; font-weight: 600; letter-spacing: -.3rpx; }
.nav-back { display: flex; align-items: center; padding: 12rpx 24rpx 12rpx 0; }
.nav-chevron { width: 20rpx; height: 20rpx; border-left: 5rpx solid #1d1d1f; border-bottom: 5rpx solid #1d1d1f; transform: rotate(45deg); border-radius: 2rpx; }
.nav-action { padding: 12rpx 0; color: #1d1d1f; font-size: 32rpx; }
.nav-action.save { color: #007aff; font-weight: 600; padding-left: 24rpx; }
.nav-action.save.idle { color: #007aff; opacity: .5; }
.nav-pressed { opacity: .55; }

/* ===== 页面骨架 ===== */
.page { min-height: 100vh; padding-left: 40rpx; padding-right: 40rpx; padding-bottom: 88rpx; }
.context-line { margin: 4rpx 0 24rpx; color: #86868b; font-size: 25rpx; }
.paper { padding: 28rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 0 0 1rpx rgba(0,0,0,.04), 0 10rpx 24rpx -14rpx rgba(0,0,0,.12); transition: box-shadow 150ms ease-out; }
.paper-focus { box-shadow: 0 0 0 2rpx rgba(0,0,0,.08), 0 10rpx 24rpx -14rpx rgba(0,0,0,.12); }
.paper-input { display: block; width: 100%; color: #1d1d1f; font-size: 30rpx; line-height: 1.4; }
.paper-count { display: block; margin-top: 12rpx; text-align: right; color: #a8a5a0; font-size: 22rpx; font-variant-numeric: tabular-nums; transition: color 150ms ease-out; }
.paper-count-limit { color: #c7c4bf; }
.paper-count.warn { color: #b42318; }

.block-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin: 40rpx 0 18rpx; }
.block-title { color: #86868b; font-size: 26rpx; font-weight: 600; }
.block-link { color: #007aff; font-size: 25rpx; padding: 4rpx 0 4rpx 16rpx; }

/* ===== 人物行卡片（查看 + 编辑共用） ===== */
.people-card { border-radius: 24rpx; background: #fff; box-shadow: 0 0 0 1rpx rgba(0,0,0,.04), 0 10rpx 24rpx -14rpx rgba(0,0,0,.10); overflow: hidden; }
.prow { display: flex; align-items: center; gap: 18rpx; padding: 24rpx 28rpx; }
.prow.tap { cursor: pointer; }
.prow-pressed { background: #f5f5f6; }
.prow-avatar { display: flex; align-items: center; justify-content: center; flex: none; width: 72rpx; height: 72rpx; border-radius: 50%; background: #e7e3dc; color: #555559; font-size: 26rpx; font-weight: 600; }
.prow-avatar.photo { display: block; }
.prow-main { display: flex; flex-direction: column; gap: 4rpx; flex: 1; min-width: 0; }
.prow-name { font-size: 29rpx; font-weight: 600; color: #1d1d1f; }
.prow-imps { color: #86868b; font-size: 24rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.psep { height: 1rpx; background: rgba(0,0,0,.07); margin-left: 118rpx; }
.psep.full { margin-left: 28rpx; }
.padd { display: flex; align-items: center; justify-content: center; min-height: 88rpx; color: #86868b; font-size: 27rpx; }
.chevron { flex: none; width: 14rpx; height: 14rpx; border-right: 3rpx solid #c7c7cc; border-bottom: 3rpx solid #c7c7cc; transform: rotate(-45deg); border-radius: 2rpx; }

/* ===== 查看模式 ===== */
.view-mood { display: flex; align-items: center; gap: 10rpx; margin-top: 24rpx; color: #86868b; font-size: 25rpx; }
.view-mood .seg-dot { width: 14rpx; height: 14rpx; }
.primary { padding: 24rpx; margin-top: 42rpx; border-radius: 20rpx; background: #1d1d1f; color: #fff; font-weight: 600; }

/* ===== 编辑模式 ===== */
.edit-page { padding-bottom: 60rpx; }
.bottom-space { height: 40rpx; }
.save-btn { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 92rpx; margin-top: 48rpx; padding: 0; border-radius: 20rpx; background: #1d1d1f; color: #fff; font-size: 30rpx; font-weight: 600; line-height: 1; }
.save-btn:active { background: #353538; }
.save-btn[disabled] { background: #c7c4bf; color: #fff; }
.delete-link { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin-top: 20rpx; color: #b42318; font-size: 26rpx; transition: transform 150ms ease-out, opacity 150ms ease-out; }
.delete-link[disabled] { color: #a1a1a6; }

/* ===== 弹层（底部上拉） ===== */
.picker-overlay { position: fixed; inset: 0; z-index: 400; display: flex; align-items: flex-end; background: rgba(20,20,22,.5); }
.person-picker { width: 100%; max-height: 84vh; padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: #fff; box-shadow: 0 -8rpx 60rpx rgba(0,0,0,.16); }
.sheet-grabber { width: 72rpx; height: 8rpx; border-radius: 99rpx; background: rgba(0,0,0,.16); margin: 4rpx auto 20rpx; }
.picker-head { display: flex; align-items: center; justify-content: space-between; min-height: 72rpx; }
.picker-title { font-size: 34rpx; font-weight: 600; }
.picker-count { margin-top: 6rpx; color: #77777c; font-size: 23rpx; }
.picker-close { display: flex; align-items: center; justify-content: center; flex: none; width: 88rpx; height: 88rpx; margin: -8rpx -8rpx -8rpx 0; }
.picker-close-icon { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 50%; background: #e9e9eb; font-size: 32rpx; line-height: 1; }
.picker-close:active .picker-close-icon { background: #d8d8dc; }
.picker-hint { margin: 16rpx 0 20rpx; color: #6e6e73; font-size: 23rpx; line-height: 1.55; }
.picker-search { width: 100%; height: 80rpx; padding: 0 22rpx; border: 1rpx solid #d2d2d7; border-radius: 16rpx; background: #f8f8f8; font-size: 28rpx; }
.picker-list { max-height: 46vh; margin-top: 20rpx; }
.picker-option { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 96rpx; padding: 12rpx 4rpx; border-bottom: 1rpx solid #e8e8ea; text-align: left; }
.picker-option:active { background: #f5f5f6; }
.picker-person, .picker-status { display: flex; align-items: center; min-width: 0; }
.picker-person { flex: 1; gap: 16rpx; }
.picker-avatar { display: flex; align-items: center; justify-content: center; flex: none; width: 64rpx; height: 64rpx; border-radius: 50%; background: #ececed; font-size: 25rpx; font-weight: 600; }
.picker-avatar-image { display: block; }
.picker-person-name { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.picker-status text { color: #77777c; font-size: 24rpx; }
.picker-check { display: flex; align-items: center; justify-content: center; flex: none; width: 40rpx; height: 40rpx; margin-left: 14rpx; border: 2rpx solid rgba(0,0,0,.2); border-radius: 50%; background: #fff; font-size: 24rpx; color: #fff; }
.picker-check.selected { border-color: #1d1d1f; background: #1d1d1f; }
.picker-empty { padding: 48rpx 0; color: #6e6e73; font-size: 26rpx; text-align: center; }
.picker-done { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin-top: 20rpx; border-radius: 16rpx; background: #1d1d1f; color: #fff; font-size: 27rpx; font-weight: 600; line-height: 1; }
.picker-done:active { background: #353538; }
.picker-add { display: flex; align-items: center; gap: 14rpx; margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #e8e8ea; }
.picker-add input { flex: 1; min-width: 0; height: 80rpx; padding: 0 22rpx; border-radius: 16rpx; background: #f5f5f4; font-size: 26rpx; }
.picker-add button { display: flex; align-items: center; justify-content: center; flex: none; min-width: 120rpx; height: 80rpx; border-radius: 16rpx; background: #1d1d1f; color: #fff; font-size: 26rpx; }

/* 印象选择：chip 网格 */
.tag-chip-grid { display: flex; flex-wrap: wrap; gap: 14rpx; padding: 8rpx 4rpx 16rpx; }
.tag-chip { display: inline-flex; align-items: center; min-height: 72rpx; padding: 0 24rpx; border-radius: 12rpx; background: rgba(0,0,0,.055); color: #555559; font-size: 25rpx; transition: transform 150ms ease-out, background-color 150ms ease-out, color 150ms ease-out; }
.tag-chip.on { background: #1d1d1f; color: #fff; }
.tag-chip.tag-add-chip { border: 1rpx dashed #b9b9be; background: transparent; color: #86868b; }
.pill-pressed { transform: scale(0.96); }
.picker-head-row { display: flex; align-items: center; gap: 14rpx; flex: 1; min-width: 0; }
.tag-selected-badge { flex: none; padding: 4rpx 14rpx; border-radius: 8rpx; background: #f2f2f4; color: #6e6e73; font-size: 22rpx; }

.mood-sync-status { display: flex; align-items: center; gap: 16rpx; margin: 12rpx 0; font-size: 24rpx; color: #817b72; }
.mood-sync-status button { margin: 0; padding: 12rpx 20rpx; font-size: 24rpx; color: #1d1d1f; background: #eae5dc; border-radius: 12rpx; }

button.prow { width: 100%; text-align: left; }
button.padd { width: 100%; }

/* 编辑页：与快速记录一致的白底便笺。查看态保留原有布局。 */
.nav-edit { background: #fff; backdrop-filter: none; -webkit-backdrop-filter: none; }
.page-edit { background: #fff; padding-left: 42rpx; padding-right: 42rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.edit-page { padding-bottom: 0; }
.edit-page .context-line { margin: 24rpx 0 42rpx; color: #86868b; font-size: 25rpx; }
.edit-page .paper { display: flex; flex-direction: column; min-height: 380rpx; padding: 0 0 48rpx; border-radius: 0; background: transparent; box-shadow: none; }
.edit-page .paper-input { min-height: 230rpx; padding-top: 8rpx; font-size: 36rpx; line-height: 1.4; }
.edit-page .paper-count { margin-top: auto; padding-top: 24rpx; color: #86868b; font-size: 23rpx; }
.edit-page .paper-count-limit { color: inherit; }
.edit-page .paper-count.warn { color: #b42318; }
.mood-summary { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 128rpx; gap: 24rpx; padding: 24rpx 0; border-top: 1rpx solid #e8e8ed; border-bottom: 1rpx solid #e8e8ed; text-align: left; }
.mood-label { flex: none; font-size: 29rpx; font-weight: 600; }
.mood-value { display: flex; align-items: center; gap: 20rpx; font-size: 29rpx; }
.mood-dot { flex: none; width: 30rpx; height: 30rpx; border-radius: 50%; }
.mood-placeholder { color: #86868b; font-size: 26rpx; }
.edit-page .chevron { margin-left: 10rpx; border-color: #86868b; }
.edit-page .block-head { align-items: center; margin: 24rpx 0 0; min-height: 88rpx; }
.edit-page .block-title { color: #1d1d1f; font-size: 29rpx; font-weight: 600; }
.people-add { display: flex; align-items: center; justify-content: flex-end; min-height: 88rpx; min-width: 140rpx; color: #86868b; font-size: 27rpx; }
.edit-page .people-card { border-radius: 0; box-shadow: none; overflow: visible; }
.edit-page .prow { min-height: 142rpx; padding: 22rpx 0; gap: 26rpx; }
.edit-page .prow-avatar { width: 94rpx; height: 94rpx; background: #f0ede7; color: #1d1d1f; font-size: 36rpx; font-weight: 500; }
.edit-page .prow-main { gap: 8rpx; }
.edit-page .prow-name { font-size: 30rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.edit-page .prow-imps { font-size: 25rpx; }
.edit-page .psep { margin-left: 0; background: #e8e8ed; }
.edit-page .save-btn { min-height: 96rpx; margin-top: 48rpx; border-radius: 24rpx; }
.edit-page .delete-link { margin-top: 20rpx; min-height: 88rpx; font-size: 26rpx; }
.mood-options { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; padding: 4rpx 0 20rpx; }
.mood-option { display: flex; align-items: center; gap: 16rpx; min-height: 96rpx; padding: 20rpx; border: 1rpx solid #e8e8ed; border-radius: 18rpx; font-size: 28rpx; }
.mood-option.selected { border-color: #1d1d1f; background: #f5f5f4; }
.mood-check { margin-left: auto; }
.mood-picker-actions { display: flex; justify-content: space-between; border-top: 1rpx solid #e8e8ed; margin-top: 12rpx; }
.mood-picker-actions button { display: flex; align-items: center; gap: 16rpx; min-height: 96rpx; font-size: 26rpx; color: #6e6e73; }
