<view class="page people-page">
  <view class="hero"><view class="hero-head"><view class="hero-title">人物</view><view wx:if="{{!managing}}" class="hero-actions"><button hover-class="button-pressed" class="manage-link" bindtap="toggleManage">管理人物</button><button hover-class="button-pressed" class="manage-link" bindtap="manageTags">印象用词</button></view></view></view>
  <view wx:if="{{managing}}" class="manage-bar"><text class="manage-count">已选 {{selectedIds.length}} 人</text><button class="manage-cancel" hover-class="none" bindtap="toggleManage" disabled="{{deleting}}">取消</button></view>

  <scroll-view class="people-scroll" scroll-y="{{!dragId && !mapTouching}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="empty">加载中…</view>
    <view wx:elif="{{loadFailed}}" class="empty">加载失败，请检查网络。<button hover-class="button-pressed" class="retry" bindtap="retryLoad">重试</button></view>
    <block wx:else>
    <view class="map-section">
    <!-- 星图：三圈同心圆，圆心是我 -->
    <view class="map {{managing ? 'map-dim' : ''}}" style="height:{{canvasH}}rpx" bindtouchstart="onMapTouchStart" catchtouchmove="onMapTouchMove" bindtouchend="onMapTouchEnd" bindtouchcancel="onMapTouchCancel">
      <view class="map-content" style="height:{{canvasH}}rpx;transform:translate({{mapX}}px,{{mapY}}px) scale({{mapZoom}})">
      <view wx:if="{{thread}}" class="thread" style="left:{{thread.x}}rpx;top:{{thread.y}}rpx;width:{{thread.w}}rpx;transform:rotate({{thread.a}}deg)"></view>
      <view wx:for="{{stars.length ? rings : []}}" wx:key="name" class="ring {{item.near ? 'ring-near' : ''}}" style="left:{{item.cx}}rpx;top:{{item.cy}}rpx;width:{{item.r}}rpx;height:{{item.r}}rpx"></view>
      <view class="me" style="left:{{center.x}}rpx;top:{{center.y}}rpx">我</view>
      <button wx:for="{{stars}}" wx:key="id" hover-class="none" class="star {{item.id === activeId ? 'sel' : ''}}" style="left:{{item.x}}rpx;top:{{item.y}}rpx" data-id="{{item.id}}" bindtap="selectStar" aria-label="{{item.name}}，{{item.count}} 条记录，点击查看摘要">
        <view class="star-avatar">
          <image wx:if="{{item.avatarUrl}}" class="avatar photo" src="{{item.avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="avatar">{{item.avatar}}</view>
          <view class="tone-dot tone-{{item.tone}}"></view>
        </view>
        <text class="star-name">{{item.name}}</text>
      </button>
      </view>
    </view>
    <view wx:if="{{stars.length}}" class="map-tools"><text class="map-help">记录越多，离我越近</text><button hover-class="button-pressed" class="map-reset" bindtap="resetMap" aria-label="恢复星图初始大小和位置">复位</button></view>
    </view>

      <view class="people-sheet">
      <!-- 选中人物摘要：头像、标签和快速记录 -->
      <view wx:if="{{activePerson && !managing}}" class="active-row">
        <view class="ar-av">
          <image wx:if="{{activePerson.avatarUrl}}" class="avatar photo" src="{{activePerson.avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="avatar">{{activePerson.avatar}}</view>
        </view>
        <button hover-class="button-pressed" class="ar-copy" data-id="{{activePerson.id}}" bindtap="goPerson">
          <view class="ar-name">{{activePerson.name}} <text class="ar-go">›</text></view>
          <view class="ar-meta">{{activePerson.count}} 条记录{{activePerson.when ? ' · ' + activePerson.when : ''}}</view>
          <view wx:if="{{activePerson.tagList.length}}" class="ar-tags">
            <text wx:for="{{activePerson.tagList}}" wx:key="name" class="ar-tag">{{item.name}}</text>
          </view>
        </button>
        <button hover-class="button-pressed" class="ar-record" data-id="{{activePerson.id}}" bindtap="recordFor" aria-label="为选中人物记一件事"><view class="ar-add">＋</view><text class="ar-record-label">记一件事</text></button>
      </view>

      <view class="people-list-head"><text class="people-list-title">全部人物</text><button hover-class="button-pressed" class="create-person" bindtap="showCreate">＋ 新建人物</button></view>
      <view class="search-row">
        <input class="search" value="{{query}}" placeholder="搜索人物" confirm-type="search" bindinput="search" placeholder-class="text-entry-placeholder" />
        <button hover-class="button-pressed" wx:if="{{query}}" class="search-clear" bindtap="clearSearch" aria-label="清除搜索">×</button>
      </view>

      <view class="grid {{managing ? 'grid-managing' : ''}}">
        <button hover-class="button-pressed" wx:for="{{people}}" wx:key="id" class="file-card sortable {{item.selected ? 'selected' : ''}} {{item.id === dragId ? 'dragging' : ''}} {{item.id === activeId ? 'active' : ''}}" style="{{item.id === dragId ? 'transform: translateX(' + dragDx + 'px) translateY(' + dragDy + 'px) scale(1.03);' : ''}}" data-id="{{item.id}}" bindtap="openPerson" bindlongpress="onCardLongPress" bindtouchmove="onCardTouchMove" bindtouchcancel="onCardTouchEnd" bindtouchend="onCardTouchEnd">
          <view class="file-avatar">
            <image wx:if="{{item.avatarUrl}}" class="avatar photo" src="{{item.avatarUrl}}" mode="aspectFill"/>
            <view wx:else class="avatar">{{item.avatar}}</view>
          </view>
          <view class="file-copy">
            <view class="file-name">{{item.name}}</view>
            <view wx:if="{{item.tagList.length}}" class="file-tags"><text wx:for="{{item.tagList}}" wx:for-item="tag" wx:key="name" class="file-tag">{{tag.name}}</text></view>
            <view wx:else class="file-no-tags">暂无印象标签</view>
            <view class="file-foot"><view class="tone-dot tone-{{item.tone}}"></view><text>{{item.count}} 条记录</text><text class="file-when">{{item.when || '待开始'}}</text></view>
          </view>
          <text wx:if="{{!managing}}" class="file-go">›</text>
          <view wx:if="{{managing}}" class="check {{item.selected ? 'selected' : ''}}"><text wx:if="{{item.selected}}" class="check-mark">✓</text></view>
        </button>
      </view>
      <view wx:if="{{!people.length}}" class="empty">{{query ? '没有找到相关人物，换个名字试试。' : '先新建一位人物，再记录你们之间的重要事件。'}}</view>
      </view>
    </block>
  </scroll-view>

  <button hover-class="button-pressed" wx:if="{{managing}}" class="manage-delete" bindtap="deleteSelected" disabled="{{!selectedIds.length || deleting}}">{{deleting ? '处理中…' : (selectedIds.length ? '删除所选（' + selectedIds.length + '）' : '删除所选')}}</button>

  <view wx:if="{{showCreate}}" class="create-overlay" catchtap="hideCreate">
  <view class="create-dialog" catchtap="noop">
    <view class="sheet-title">新建人物</view>
    <input maxlength="30" confirm-type="next" bindconfirm="focusNote" aria-label="名字" bindblur="blurInput" focus="{{focusField === 'name'}}" cursor-spacing="24" disabled="{{creating}}" class="field" placeholder="名字（必填）" value="{{name}}" bindinput="changeName" placeholder-class="text-entry-placeholder" />
    <input maxlength="200" confirm-type="done" bindconfirm="savePerson" aria-label="备注" bindblur="blurInput" focus="{{focusField === 'note'}}" cursor-spacing="24" disabled="{{creating}}" class="field" placeholder="备注" value="{{note}}" bindinput="changeNote" placeholder-class="text-entry-placeholder" />
    <view class="dialog-actions"><button hover-class="button-pressed" class="cancel" disabled="{{creating}}" bindtap="hideCreate">取消</button><button hover-class="button-pressed" class="primary" disabled="{{creating}}" bindtap="savePerson">{{creating ? '保存中…' : '保存'}}</button></view>
  </view></view>
</view>
