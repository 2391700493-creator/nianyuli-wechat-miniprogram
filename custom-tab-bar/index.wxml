<view wx:if="{{!hidden}}" class="tab-bar"><view class="tabs"><button hover-class="button-pressed" wx:for="{{tabs}}" wx:key="pagePath" class="tab {{selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="switchTab"><image class="tab-icon" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit" /><text>{{item.text}}</text></button></view></view>
