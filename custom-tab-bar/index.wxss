.tab-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 100; padding-bottom: env(safe-area-inset-bottom); border-top: 1rpx solid #e5e5e7; background: #f5f5f4; }
.tabs { display: flex; height: 104rpx; }
.tab { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 5rpx; min-width: 0; color: #77777c; font-size: 21rpx; line-height: 1.2; }
.tab.active { color: #1d1d1f; }
.tab-icon { display: block; width: 44rpx; height: 44rpx; }

.tab { margin: 0; padding: 0; border-radius: 0; background: transparent; }
.tab::after { border: 0; }
.tab:focus-visible { outline: 3rpx solid #817b72; outline-offset: -4rpx; }

.button-pressed { opacity: .7; }
